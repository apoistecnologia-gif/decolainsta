# Banco PostgreSQL (não inclua segredos reais no repositório)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Autenticação do NextAuth; gere uma chave aleatória distinta da criptografia
AUTH_SECRET="SUA_CHAVE_ALEATORIA_MINIMO_32_CARACTERES"
# AES-256-GCM, preserve esta chave para conseguir renovar os tokens
ENCRYPTION_KEY="OUTRA_CHAVE_ALEATORIA_MINIMO_32_CARACTERES"
# Meta Instagram Unified Login: ID e segredo do aplicativo Meta (não do antigo Instagram Login)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# ID da configuração "API do Instagram (login unificado)" no painel da Meta
INSTAGRAM_CONFIG_ID=""
INSTAGRAM_REDIRECT_URI="https://SEU-DOMINIO.com/api/instagram/connect/callback"
INSTAGRAM_API_VERSION="v24.0"
# Login unificado usa config_id no OAuth do Facebook e Graph API da Meta.
# Conta Instagram precisa ser profissional e compartilhada no portfólio empresarial.
# Apenas se criar um admin de forma explícita com npm run db:seed
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""

# Opcional, mas recomendado em produção: URL pública base do NextAuth
# AUTH_URL="https://SEU-DOMINIO.com"

# Assistente GPT para estratégias a partir de informações públicas sobre referências.
# Desativado por padrão. Configure no servidor, NUNCA em NEXT_PUBLIC_*.
# Requer conta na OpenAI Platform com faturamento de API próprio;
# ChatGPT Plus não fornece créditos automáticos para esta integração.
DECOLAINSTA_AI_ENABLED="false"
# OPENAI_API_KEY="sk-..."  # Configure SOMENTE no cofre de variáveis da Vercel.
OPENAI_MODEL="gpt-4.1-mini"
